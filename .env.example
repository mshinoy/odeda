# Copy to .env and edit. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env && docker compose up -d

# ---------------------------------------------------------------------------
# Access control  (the only setting you really must change)
# ---------------------------------------------------------------------------

# Single password protecting the whole dashboard. Stored only as a salted
# PBKDF2-SHA256 hash; the plaintext never reaches the database.
# Leave it empty and the app runs WITHOUT any authentication — acceptable on a
# laptop, not acceptable on anything reachable from a network.
# Changing this value rotates the password and signs out every existing session.
APP_PASSWORD=change-me

# Set to 1 when serving over HTTPS (behind a reverse proxy) so the session cookie
# is marked Secure. Leave 0 for plain http://localhost.
GA_COOKIE_SECURE=0

# How long a browser stays signed in.
GA_SESSION_DAYS=30

# Host port the dashboard is published on. Compose binds it to 127.0.0.1.
GA_PUBLIC_PORT=8000

# Hours between automatic syncs of Garmin and Google Health (whichever are
# connected). Counted from the last run, so a restart does not reset it. 0 = off;
# Sync now in Settings works either way.
GA_AUTO_SYNC_HOURS=6

# ---------------------------------------------------------------------------
# Your Garmin account
# ---------------------------------------------------------------------------
# There is deliberately NO GARMIN_EMAIL / GARMIN_PASSWORD here.
# You sign in once with `docker compose exec app garmin-analytics login` (add
# `--signin-url`, then `--ticket`, to sign in through your own browser instead). The
# password is used once to obtain a token and is never stored; only the token cache
# is kept, on the volume, mode 0600.

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------

# 1 = generate synthetic data on first start so there is something to look at
# before you connect an account. Only runs when no database exists yet.
# It is clearly labelled as synthetic in the UI. Set to 0 for a real deployment.
GA_SEED_DEMO=0
GA_SEED_MONTHS=40

# ---------------------------------------------------------------------------
# Athlete profile — used by TRIMP, heart-rate zones and readiness
# ---------------------------------------------------------------------------
GA_HR_REST=52
GA_HR_MAX=187
GA_SEX=male

# ---------------------------------------------------------------------------
# Basemap — read at image build time (`docker compose build`), not at runtime
# ---------------------------------------------------------------------------
# A Mapbox pk token is public: it ends up in the JavaScript bundle, so restrict it
# by URL in your Mapbox account. Leave the styles empty for the built-in defaults.
VITE_MAPBOX_TOKEN=
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=

# ---------------------------------------------------------------------------
# Time zone
# ---------------------------------------------------------------------------
# The container's clock is UTC unless you say otherwise, and several figures are
# anchored on "today" in local time: the race countdown, the current consistency
# streak, and the 28-day rolling volume. Leave this unset and, for the hours
# either side of midnight, they are computed for the wrong day.
# Use your own IANA zone name; the image ships the full tzdata database.
TZ=Etc/UTC
