# FastAPI backend. Dev requests to /api are proxied here by Vite.
VITE_API_URL=http://127.0.0.1:8000

# Optional. When set, maps use Mapbox styles; when empty, MapLibre with the free styles below.
VITE_MAPBOX_TOKEN=

# Basemap style URLs (MapLibre). Point these at your own tile server to stay fully self-hosted.
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
