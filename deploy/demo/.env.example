# The address Cloudflare connects to: this machine's public IPv6 address in square brackets,
# e.g. [2001:db8::1]. (Use an IPv4 address instead if port 443 is free on it.)
EDGE_BIND_IP=
# Folder holding cert.pem and key.pem: a Cloudflare Origin Certificate for the domain.
EDGE_CERT_DIR=
# The port Cloudflare connects to. Its free plan always uses 443.
EDGE_PORT=443

# The demo's maps use Mapbox, through the edge: the page asks this site for map data and the
# edge adds this token on the server, so it is never in the page code. Without a token the
# basemap is blank; to use the free CARTO maps instead, build with VITE_MAPBOX_PROXY set to an
# empty value. Create a token just for the demo, give it only the public scopes, restrict it
# to the demo's own address (URL restrictions: https://odeda.run/*), and set a usage alert in
# your Mapbox account: the limits in nginx.conf.template slow abuse down, they cannot cap a
# monthly bill.
MAPBOX_TOKEN=
