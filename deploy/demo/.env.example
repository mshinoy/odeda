# The address Cloudflare connects to: this machine's public IPv6 address in square brackets,
# e.g. [2001:db8::1]. (Use an IPv4 address instead if port 443 is free on it.)
EDGE_BIND_IP=
# Folder holding cert.pem and key.pem: a Cloudflare Origin Certificate for the domain.
EDGE_CERT_DIR=
# The port Cloudflare connects to. Its free plan always uses 443.
EDGE_PORT=443
