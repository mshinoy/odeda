#!/bin/sh
# Keep PLAN.md current: a commit that changes code must also change PLAN.md
# (the task's status, the phase count, or the snapshot at the top).
#
# Turn it on once per clone:  git config core.hooksPath .githooks
# Skip it for a commit that truly changes no behaviour:  SKIP_PLAN_CHECK=1 git commit ...

[ -n "$SKIP_PLAN_CHECK" ] && exit 0

staged=$(git diff --cached --name-only)

code=$(printf '%s\n' "$staged" | grep -E '^(frontend/src/|frontend/public/|odeda/|tests/|scripts/|docker/|Dockerfile|docker-compose\.yml|pyproject\.toml|requirements\.txt|frontend/package(-lock)?\.json)' || true)
[ -z "$code" ] && exit 0

if printf '%s\n' "$staged" | grep -qx 'PLAN.md'; then
  exit 0
fi

echo "PLAN.md is not part of this commit, but code is."
echo "Update the task's row (status, phase count) and the snapshot at the top of PLAN.md,"
echo "stage it, and commit again. Nothing is built without a row: see \"How work moves\"."
echo "For a commit that changes no behaviour: SKIP_PLAN_CHECK=1 git commit ..."
exit 1
